{
  "schemaVersion": 1,
  "id": "io.github.aicyraa.compass-menu",
  "name": "Compass",
  "version": "1.0.0",
  "author": "Aicyraa",
  "description": "A command menu for Omarchy with a category rail, recents, fuzzy search and keyboard hints.",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Compass",
    "description": "Opens the Compass menu",
    "category": "Compositor",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "license": "MIT",
  "homepage": "https://github.com/Aicyraa/omarchy-compass-menu"
}
